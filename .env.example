# ============================================================================
#  Copy to `.env` and fill in real values:   cp .env.example .env && chmod 600 .env
#  `.env` is listed in .gitignore - NEVER commit it.
#  Generate strong passwords, e.g.:   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
#  (use letters and digits only: the values are placed into SQL by the init script)
# ============================================================================

# --- MySQL -------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=stayease
DB_USER=stayease_app
DB_PASSWORD=change-me-app-password

# --- Application ---------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# --- Admin login (dashboard at /#/admin) ---------------------------------------------
# ADMIN_PASSWORD_HASH is a salted PBKDF2 hash - never put the plain password here.
# Make one:  see docs/CLOUD-DEPLOY.md ("Admin login").  Leave both empty to disable admin login.
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# true = admin cookie only over HTTPS (production). false only for plain-HTTP tests by IP.
COOKIE_SECURE=true

# --- Public site (documentation / nginx server_name lives in nginx/nginx.conf) ----
PUBLIC_URL=https://hotel-reservation.opscloud.eu.cc

# --- Image names (used by CI/CD when images are pulled from GHCR) -----------------
IMAGE_PREFIX=ghcr.io/hitmancoder6961234-coder/hotel-reservation-system-management
IMAGE_TAG=latest
